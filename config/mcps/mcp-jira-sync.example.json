{
  "transport": "stdio",
  "command": "../mcp-hub/.venv/Scripts/python.exe",
  "args": ["server.py"],
  "cwd": "../mcp-jira-sync",
  "inheritEnv": ["PATH", "SYSTEMROOT", "WINDIR", "TEMP", "TMP", "USERPROFILE"],
  "timeoutSeconds": 60,
  "env": {
    "CENTRAL_CONFIG_PATH": "../mcp-hub/config/private/mcps/mcp-jira-sync.json",
    "PYTHON_DOTENV_DISABLED": "1"
  },
  "jira": {
    "base_url": "https://your-domain.atlassian.net",
    "email": "<SET_BY_USER>",
    "api_token": "<SET_BY_USER>",
    "max_asset_size_mb": 15
  }
}
