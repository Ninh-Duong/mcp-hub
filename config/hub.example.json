{
  "version": 1,
  "servers": {
    "mcp-server-logs": {
      "enabled": false,
      "repository": "https://github.com/Ninh-Duong/mcp-server-logs.git",
      "configFile": "config/private/mcps/mcp-server-logs.json",
      "prepare": {
        "runtime": {
          "name": "node",
          "minVersion": "22.0.0",
          "winget": "OpenJS.NodeJS.LTS"
        },
        "command": ["node", "start.mjs", "--preflight"]
      }
    },
    "mcp-jira-sync": {
      "enabled": false,
      "repository": "https://github.com/Ninh-Duong/mcp-jira-sync.git",
      "configFile": "config/private/mcps/mcp-jira-sync.json"
    },
    "mcp-pr-companion": {
      "enabled": false,
      "repository": "https://github.com/Ninh-Duong/mcp-pr-companion.git",
      "configFile": "config/private/mcps/mcp-pr-companion.json",
      "prepare": {
        "runtime": {
          "name": "node",
          "minVersion": "20.12.0",
          "winget": "OpenJS.NodeJS.LTS"
        },
        "command": ["node", "bin/cli.js", "prepare"]
      }
    },
    "mcp-read-source": {
      "enabled": false,
      "repository": "https://github.com/Ninh-Duong/mcp-read-source.git",
      "configFile": "config/private/mcps/mcp-read-source.json"
    },
    "mcp-sqlserver": {
      "enabled": false,
      "repository": "https://github.com/Ninh-Duong/mcp-sqlserver.git",
      "configFile": "config/private/mcps/mcp-sqlserver.json",
      "prepare": {
        "runtime": {
          "name": "dotnet",
          "minVersion": "10.0.0",
          "winget": "Microsoft.DotNet.SDK.10"
        },
        "command": ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "scripts/prepare.ps1"]
      }
    }
  },
  "features": {
    "logs": {
      "enabled": false,
      "tools": [
        {
          "server": "mcp-server-logs",
          "name": "list_log_providers",
          "exposeAs": "logs__list_log_providers",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-server-logs",
          "name": "query_logs",
          "exposeAs": "logs__query_logs",
          "cacheSeconds": 60
        },
        {
          "server": "mcp-server-logs",
          "name": "list_openobserve_organizations",
          "exposeAs": "logs__list_openobserve_organizations",
          "cacheSeconds": 300
        },
        {
          "server": "mcp-server-logs",
          "name": "list_openobserve_streams",
          "exposeAs": "logs__list_openobserve_streams",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-server-logs",
          "name": "list_openobserve_stream_schema",
          "exposeAs": "logs__list_openobserve_stream_schema",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-server-logs",
          "name": "list_openobserve_services",
          "exposeAs": "logs__list_openobserve_services",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-server-logs",
          "name": "get_openobserve_service_logs",
          "exposeAs": "logs__get_openobserve_service_logs",
          "cacheSeconds": 60
        },
        {
          "server": "mcp-server-logs",
          "name": "search_openobserve_logs",
          "exposeAs": "logs__search_openobserve_logs",
          "cacheSeconds": 60
        },
        {
          "server": "mcp-server-logs",
          "name": "find_openobserve_logs_by_rcid",
          "exposeAs": "logs__find_openobserve_logs_by_rcid",
          "cacheSeconds": 60
        },
        {
          "server": "mcp-server-logs",
          "name": "export_openobserve_logs",
          "exposeAs": "logs__export_openobserve_logs"
        },
        {
          "server": "mcp-server-logs",
          "name": "list_ai_context_snapshots",
          "exposeAs": "logs__list_ai_context_snapshots",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-server-logs",
          "name": "read_ai_context",
          "exposeAs": "logs__read_ai_context",
          "cacheSeconds": 60
        }
      ]
    },
    "jira": {
      "enabled": false,
      "tools": [
        {
          "server": "mcp-jira-sync",
          "name": "jira_check_connection",
          "exposeAs": "jira__check_connection",
          "cacheSeconds": 300
        },
        {
          "server": "mcp-jira-sync",
          "name": "jira_list_synced",
          "exposeAs": "jira__list_synced",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-jira-sync",
          "name": "jira_sync_ticket",
          "exposeAs": "jira__sync_ticket"
        },
        {
          "server": "mcp-jira-sync",
          "name": "jira_read_ticket",
          "exposeAs": "jira__read_ticket",
          "cacheSeconds": 60
        },
        {
          "server": "mcp-jira-sync",
          "name": "jira_read_asset",
          "exposeAs": "jira__read_asset",
          "cacheSeconds": 60
        }
      ]
    },
    "pr": {
      "enabled": false,
      "tools": [
        {
          "server": "mcp-pr-companion",
          "name": "get_pr_context_pack",
          "exposeAs": "pr__get_pr_context_pack"
        },
        {
          "server": "mcp-pr-companion",
          "name": "search_pr_files",
          "exposeAs": "pr__search_pr_files"
        },
        {
          "server": "mcp-pr-companion",
          "name": "get_pr_file_context",
          "exposeAs": "pr__get_pr_file_context"
        },
        {
          "server": "mcp-pr-companion",
          "name": "get_pr_file_changes",
          "exposeAs": "pr__get_pr_file_changes"
        },
        {
          "server": "mcp-pr-companion",
          "name": "get_pr_sync_status",
          "exposeAs": "pr__get_pr_sync_status"
        },
        {
          "server": "mcp-pr-companion",
          "name": "list_synced_prs",
          "exposeAs": "pr__list_synced_prs"
        },
        {
          "server": "mcp-pr-companion",
          "name": "check_bitbucket_connection",
          "exposeAs": "pr__check_bitbucket_connection",
          "cacheSeconds": 300
        },
        {
          "server": "mcp-pr-companion",
          "name": "get_pr_comments",
          "exposeAs": "pr__get_pr_comments"
        },
        {
          "server": "mcp-pr-companion",
          "name": "list_my_open_prs",
          "exposeAs": "pr__list_my_open_prs"
        },
        {
          "server": "mcp-pr-companion",
          "name": "sync_my_open_prs",
          "exposeAs": "pr__sync_my_open_prs"
        }
      ]
    },
    "source": {
      "enabled": false,
      "tools": [
        {
          "server": "mcp-read-source",
          "name": "source__check_connection",
          "exposeAs": "source__check_connection",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-read-source",
          "name": "source__search",
          "exposeAs": "source__search"
        },
        {
          "server": "mcp-read-source",
          "name": "source__read",
          "exposeAs": "source__read"
        }
      ]
    },
    "sql": {
      "enabled": false,
      "tools": [
        {
          "server": "mcp-sqlserver",
          "name": "check_connection",
          "exposeAs": "sql__check_connection",
          "cacheSeconds": 60
        },
        {
          "server": "mcp-sqlserver",
          "name": "list_databases",
          "exposeAs": "sql__list_databases",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-sqlserver",
          "name": "list_tables",
          "exposeAs": "sql__list_tables",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-sqlserver",
          "name": "describe_table",
          "exposeAs": "sql__describe_table",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-sqlserver",
          "name": "find_columns",
          "exposeAs": "sql__find_columns",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-sqlserver",
          "name": "lookup_rows",
          "exposeAs": "sql__lookup_rows"
        },
        {
          "server": "mcp-sqlserver",
          "name": "get_related_rows",
          "exposeAs": "sql__get_related_rows"
        },
        {
          "server": "mcp-sqlserver",
          "name": "run_select",
          "exposeAs": "sql__run_select"
        },
        {
          "server": "mcp-sqlserver",
          "name": "explain_select",
          "exposeAs": "sql__explain_select"
        },
        {
          "server": "mcp-sqlserver",
          "name": "get_object_definition",
          "exposeAs": "sql__get_object_definition",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-sqlserver",
          "name": "search_context",
          "exposeAs": "sql__search_context",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-sqlserver",
          "name": "get_object_context",
          "exposeAs": "sql__get_object_context",
          "cacheSeconds": 120
        },
        {
          "server": "mcp-sqlserver",
          "name": "check_schema_drift",
          "exposeAs": "sql__check_schema_drift",
          "cacheSeconds": 300
        }
      ]
    }
  }
}
